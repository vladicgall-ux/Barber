# ===== Supabase =====
# Project URL and keys: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER ONLY, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Telegram notifications =====
# Create a bot via @BotFather, then add it to your admin chat/group
# and get the chat id (e.g. via @userinfobot or getUpdates).
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_ADMIN_CHAT_ID=-1001234567890

# ===== VK community notifications (optional) =====
VK_GROUP_TOKEN=
VK_GROUP_ID=

# ===== VK Mini App authentication =====
# VK app's "Защищённый ключ" (Secure key): VK Apps admin -> your app ->
# Settings. Used to verify VK's signed launch params (vk_user_id, sign, ...)
# when the site is opened from inside VK.
VK_APP_SECRET=

# ===== User authentication (Telegram / MAX / VK / browser code login) =====
# Random long string used to sign the end-user session cookie (30 days).
# Generate one with: openssl rand -hex 32
AUTH_SESSION_SECRET=change-me-too

# MAX Mini App bot — same purpose as TELEGRAM_BOT_TOKEN above, for the MAX platform.
MAX_BOT_TOKEN=
# Base URL of MAX's Bot API, if different from the default https://botapi.max.ru
MAX_BOT_API_BASE=

# Shown to browser users during code login ("send this code to @bot_username").
TELEGRAM_BOT_USERNAME=your_bot
MAX_BOT_USERNAME=your_max_bot

# Shared secrets checked on incoming bot webhooks (set the same value when
# registering the webhook URL with each platform).
TELEGRAM_WEBHOOK_SECRET=change-me
MAX_WEBHOOK_SECRET=change-me

# Comma-separated Telegram/MAX/VK user ids exempt from the "confirm phone +
# name" gate before booking, AND who see the embedded admin panel (no
# password — gated purely by session + this list), e.g. "123456789,987654321".
ADMIN_IDS=

# ===== Reminder cron (POST /api/cron/send-reminders) =====
# Shared secret checked against the Authorization: Bearer header. Set the
# identical value in the Supabase pg_cron job that calls this endpoint.
# Generate one with: openssl rand -hex 24
CRON_SECRET=change-me
